# ==============================================================================
# CriteriaGuard Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Contributor / Offline Mock Mode (RECOMMENDED FOR NEW CONTRIBUTORS)
# ------------------------------------------------------------------------------
# Set to 'true' to run frontend & backend completely offline without any API keys!
# Uses in-memory database pre-seeded with sample tender, bidders, and audit trail.
MOCK_LLM=true
USE_SAMPLE_DATA=true
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Production / Cloud Credentials (Optional for local development & testing)
# ------------------------------------------------------------------------------
# Groq API key for Llama 3.3 LLM extraction
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Cloud Vision API Key (Optional OCR fallback)
GOOGLE_CLOUD_VISION_API_KEY=AIza_optional_cloud_vision_key

# Supabase PostgreSQL Database (Optional in mock mode)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ_your_service_role_key_here
SUPABASE_KEY=eyJ_your_anon_key_here

# Application security secret
SECRET_KEY=criteriaguard-dev-secret-key-change-in-production
